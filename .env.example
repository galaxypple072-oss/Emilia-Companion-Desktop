# NapCat OneBot HTTP server. Keep it bound to localhost.
ONEBOT_HTTP_URL=http://127.0.0.1:3000

# NapCat OneBot WebSocket server. Keep it bound to localhost.
ONEBOT_WS_URL=ws://127.0.0.1:3001

# Generate a random token of at least 16 characters in NapCat WebUI.
ONEBOT_ACCESS_TOKEN=replace-with-a-long-random-token

# Only these QQ accounts may receive messages or trigger inbound events.
# Separate multiple accounts with commas. For the first probe, use only your main QQ.
ONEBOT_ALLOWED_QQ=123456789

ONEBOT_REQUEST_TIMEOUT_MS=10000

# Defaults to %LOCALAPPDATA%\PersonalCompanion on Windows and ./data elsewhere.
# CORE_DATA_DIR=./data
CORE_POLL_INTERVAL_MS=1000
CORE_RECONNECT_DELAY_MS=5000

# Optional desktop-client bridge. Open only this port on the Windows LAN firewall.
COMPANION_BRIDGE_ENABLED=false
COMPANION_BRIDGE_HOST=0.0.0.0
COMPANION_BRIDGE_PORT=8765
# Use a different random token from ONEBOT_ACCESS_TOKEN (at least 24 characters).
COMPANION_BRIDGE_TOKEN=
COMPANION_BRIDGE_NAME=Emilia Core

# Windows-only local voice module.  GPT-SoVITS itself remains at 127.0.0.1:9872.
# VOICE_SERVICE_TOKEN must be a different, random token (at least 24 characters).
# VOICE_SERVICE_HOST=0.0.0.0
# VOICE_SERVICE_PORT=9873
# VOICE_SERVICE_TOKEN=
# VOICE_GRADIO_URL=http://127.0.0.1:9872
# VOICE_REFERENCE_ROOT=D:\\EmiliaVoice\\voice-source\\Emilia
# VOICE_OUTPUT_DIR=D:\\EmiliaVoice\\voice-output
# VOICE_GPT_WEIGHT=GPT_weights_v2Pro/EMILIA-LIM-R3-e50.ckpt
# VOICE_SOVITS_WEIGHT=SoVITS_weights_v2Pro/EMILIA_LIM_R2_e8_s1624.pth
# VOICE_NATURAL_REFERENCE_SOURCE=

# Core only calls the local voice module. It then delivers encrypted, small
# audio chunks over the existing Companion connection; no Windows TTS port is
# exposed to a desktop client.
# VOICE_AUTO_PLAY_ENABLED=false
# VOICE_SERVICE_ENDPOINT=http://127.0.0.1:9873
# VOICE_SERVICE_TOKEN=

# Optional privacy-preserving relay. The existing LAN bridge can remain enabled as a fallback.
# Both Core and desktop connect outbound; the relay only sees encrypted frames and routing metadata.
COMPANION_RELAY_ENABLED=false
COMPANION_RELAY_URL=wss://relay.example.com/
# Format: emilia1.<device-id>.<256-bit-base64url-secret>. Never send this value to the relay service.
COMPANION_RELAY_PAIRING_CODE=

# Optional OpenAI-compatible agent. Leave AGENT_API_KEY unset to disable model calls.
AGENT_BASE_URL=https://api.deepseek.com
AGENT_API_KEY=
AGENT_MODEL=deepseek-v4-flash
AGENT_THINKING=disabled
AGENT_MAX_TOKENS=800
AGENT_TEMPERATURE=0.8
AGENT_TIMEOUT_MS=60000
AGENT_CONTEXT_MESSAGES=20

# Optional role-playing model for casual, venting, and emotional chat only.
# Tasks, tools, search, files, email, and factual questions stay on the primary agent.
ROLEPLAY_ENABLED=false
ROLEPLAY_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
ROLEPLAY_API_KEY=
ROLEPLAY_MODEL=qwen-flash-character-2026-02-26
ROLEPLAY_MAX_TOKENS=500
ROLEPLAY_TEMPERATURE=0.85
ROLEPLAY_TIMEOUT_MS=60000
ROLEPLAY_CONTEXT_MESSAGES=20
# Semicolon-separated absolute folders available to the scoped file MCP and confirmed file sender.
COMPANION_FILE_ROOTS=

# Event-backed web discovery. No interest subscriptions means no searches or messages.
DISCOVERY_ENABLED=false
DISCOVERY_POLL_SECONDS=300
DISCOVERY_MIN_INTERVAL_HOURS=12
DISCOVERY_DAILY_SHARE_LIMIT=1
DISCOVERY_TIME_ZONE=Asia/Shanghai

WEATHER_ENABLED=false
WEATHER_POLL_SECONDS=600
WEATHER_MIN_INTERVAL_HOURS=3
WEATHER_DAILY_ALERT_LIMIT=2
WEATHER_TIME_ZONE=Asia/Shanghai

# Read-only IMAP inbox monitoring. It reuses SMTP_USER and SMTP_PASSWORD unless overridden.
EMAIL_INBOX_ENABLED=false
IMAP_HOST=imap.163.com
IMAP_PORT=993
IMAP_SECURE=true
IMAP_MAILBOX=INBOX
EMAIL_INBOX_POLL_SECONDS=120
EMAIL_INBOX_BATCH_SIZE=20
# Semicolon- or comma-separated addresses that must always notify you. BOSS_EMAIL is included automatically.
EMAIL_IMPORTANT_SENDERS=
